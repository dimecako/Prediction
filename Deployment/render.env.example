# Render web app with an external Neon PostgreSQL database, Dockerfile.
# Choose Free explicitly for every service. Do not attach a paid disk.
# Use /health as the health check path; do not expose /analyse without authentication.
WebAccess__Username=replace-with-your-username
WebAccess__Password=replace-with-a-unique-strong-password
ConnectionStrings__FootballDb=Host=replace-with-neon-host;Port=5432;Database=replace-with-neon-database;Username=replace-with-neon-user;Password=replace-with-neon-password;SSL Mode=VerifyFull
# Restore and verify the existing database in Neon before starting the web app.
# A complete restore includes EF migration history; no startup migration is needed.
# Apply future migrations explicitly after taking a backup.
Database__ApplyMigrations=false
FLARESOLVERR_URL=https://replace-with-flare-service.onrender.com/v1
FLARESOLVERR_API_KEY=replace-with-the-same-random-key-used-by-the-flare-service

# FlareSolverr: separate Free web service using Deployment/FlareSolverr.Dockerfile.
# Set the same FLARESOLVERR_API_KEY (at least 32 bytes); use /health for health checks.
# Render sets PORT for both services. Only the gateway port is public.
# Free web services sleep and share the workspace's free instance-hour allowance.
# Do not create a Render Free PostgreSQL database: it expires after 30 days.
# Neon Free has usage limits; keep independent backups and monitor storage/compute.
# Excel exports and newly trained model files are ephemeral on Free web instances.
# Train models locally for now; model inference is not yet connected to web predictions.
# Never commit real credentials or import this example without replacing placeholders.
